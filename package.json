{
  "name": "tiqs-web-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright JavaScript tests for the TIQS trading web app",
  "scripts": {
    "test": "playwright test tests/login.spec.js --project=chromium",
    "test:all": "playwright test --project=chromium",
    "test:headed": "playwright test tests/login.spec.js --project=chromium --headed",
    "browsers": "playwright install chromium firefox webkit chrome msedge",
    "jenkins:setup": "node jenkins/setupJob.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "dotenv": "^18.0.4"
  }
}
